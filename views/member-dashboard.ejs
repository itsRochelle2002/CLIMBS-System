<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Dashboard - CLIMBS</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/member-dashboard.css">
</head>
<body>
    <div class="container-fluid">
        <header>
            <div class="header-left">
                <h1 style="cursor:pointer" onclick="showSection('overview')" title="Back to overview">👤 Member Dashboard</h1>
            </div>
            <div class="header-right">
                <span class="member-badge" id="memberBadge">Loading...</span>
                <button class="btn btn-logout" onclick="logout()">Logout</button>
            </div>
        </header>

        <!-- Pending Verification Notice -->
        <div id="pendingNotice" class="pending-notice" style="display: none;">
            <div class="notice-icon">⏳</div>
            <div class="notice-content">
                <h2>Application Pending Verification</h2>
                <p>Your membership application is currently under review by our administrators.</p>
                <p>You will be notified once your account is verified and activated.</p>
            </div>
        </div>

        <!-- Verified Member Content -->
        <div id="verifiedContent" style="display: none;">
            <!-- Payment Methods Setup Section -->
            <div id="paymentMethodsSetup" class="payment-methods-section" style="display: none;">
                <div class="setup-banner">
                    <div class="setup-icon">⚠️</div>
                    <div class="setup-content">
                        <h3>Setup Payment Methods Required</h3>
                        <p>To deposit or withdraw funds, you must first add and verify your payment method (e-wallet or bank account).</p>
                        <button class="btn btn-primary" onclick="showPaymentSetupModal()">+ Add Payment Method</button>
                    </div>
                </div>
            </div>

            <!-- Payment Methods Display -->
            <div id="paymentMethodsDisplay" class="payment-methods-display" style="display: none;">
                <div class="methods-header">
                    <h3>💳 Your Payment Methods</h3>
                    <button class="btn btn-secondary btn-sm" onclick="showPaymentSetupModal()">+ Add New</button>
                </div>
                <div id="paymentMethodsList" class="methods-list">
                    <!-- Will be loaded dynamically -->
                </div>
            </div>

            <!-- Financial Summary Cards -->
            <div class="financial-summary">
                <div class="summary-card share-capital-card" onclick="showSection('shareCapital')">
                    <div class="card-icon">💰</div>
                    <div class="card-info">
                        <h3>Share Capital</h3>
                        <div class="card-amount" id="shareCapitalAmount">₱0.00</div>
                        <p class="card-label">Total Shares</p>
                    </div>
                </div>

                <div class="summary-card savings-card" onclick="showSection('savings')">
                    <div class="card-icon">🏦</div>
                    <div class="card-info">
                        <h3>Savings</h3>
                        <div class="card-amount" id="savingsAmount">₱0.00</div>
                        <p class="card-label">Total Savings</p>
                    </div>
                </div>

                <div class="summary-card loan-card" onclick="showSection('loans')">
                    <div class="card-icon">📋</div>
                    <div class="card-info">
                        <h3>Loans</h3>
                        <div class="card-amount" id="currentLoanAmount">₱0.00</div>
                        <p class="card-label">Current Loan Balance</p>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="main-content">
                <!-- Share Capital Section -->
                <div id="shareCapitalSection" class="content-section" style="display: none;">
                    <div class="section-header">
                        <h2>💰 Share Capital Management</h2>
                        <button class="btn btn-primary" onclick="showAddShareModal()">+ Add Shares</button>
                    </div>

                    <div class="balance-display">
                        <div class="balance-label">Total Share Capital</div>
                        <div class="balance-amount" id="shareCapitalBalance">₱0.00</div>
                        <div class="balance-info">Number of Shares: <span id="numberOfShares">0</span></div>
                    </div>

                    <div class="transactions-container">
                        <h3>Share Capital History</h3>
                        <div id="shareCapitalHistory" class="transactions-list">
                            <p class="no-transactions">No share capital transactions yet</p>
                        </div>
                    </div>
                </div>

                <!-- Savings Section -->
                <div id="savingsSection" class="content-section" style="display: none;">
                    <div class="section-header">
                        <h2>🏦 Savings Account</h2>
                        <div class="action-buttons">
                            <button class="btn btn-primary" onclick="showDepositModal()">💵 Deposit</button>
                            <button class="btn btn-secondary" onclick="showWithdrawModal()">💸 Withdraw</button>
                        </div>
                    </div>

                    <div class="balance-display">
                        <div class="balance-label">Total Savings Balance</div>
                        <div class="balance-amount" id="savingsBalance">₱0.00</div>
                        <div class="balance-info">Interest Rate: <span>2.5% per annum</span></div>
                    </div>

                    <div class="transactions-container">
                        <h3>Savings History</h3>
                        <div id="savingsHistory" class="transactions-list">
                            <p class="no-transactions">No savings transactions yet</p>
                        </div>
                    </div>
                </div>

                <!-- Loans Section -->
                <div id="loansSection" class="content-section" style="display: none;">
                    <div class="section-header">
                        <h2>📋 Loan Management</h2>
                        <button class="btn btn-primary" onclick="showLoanApplicationModal()">📝 Apply for Loan</button>
                    </div>

                    <div class="loan-status-cards">
                        <div class="loan-status-card">
                            <div class="status-label">Current Loan Balance</div>
                            <div class="status-value" id="loanBalance">₱0.00</div>
                        </div>
                        <div class="loan-status-card">
                            <div class="status-label">Monthly Payment</div>
                            <div class="status-value" id="monthlyPayment">₱0.00</div>
                        </div>
                        <div class="loan-status-card">
                            <div class="status-label">Loan Status</div>
                            <div class="status-value" id="loanStatus">No Active Loan</div>
                        </div>
                    </div>

                    <div class="transactions-container">
                        <h3>Loan Applications & History</h3>
                        <div id="loanHistory" class="transactions-list">
                            <p class="no-transactions">No loan applications yet</p>
                        </div>
                    </div>
                </div>

                <!-- Welcome/Overview Section (Default) -->
                <div id="overviewSection" class="content-section">
                    <div class="welcome-banner">
                        <h2>Welcome to CLIMBS Member Portal!</h2>
                        <p>Manage your Share Capital, Savings, and Loans all in one place.</p>
                    </div>

                    <div class="quick-stats">
                        <div class="stat-item">
                            <div class="stat-icon">👤</div>
                            <div class="stat-info">
                                <div class="stat-label">Member Since</div>
                                <div class="stat-value" id="memberSince">-</div>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">✅</div>
                            <div class="stat-info">
                                <div class="stat-label">Status</div>
                                <div class="stat-value verified-status">Verified Member</div>
                            </div>
                        </div>
                    </div>

                    <div class="quick-actions">
                        <h3>Quick Actions</h3>
                        <div class="action-grid">
                            <button class="action-card" onclick="showSection('shareCapital')">
                                <div class="action-icon">💰</div>
                                <div class="action-title">Manage Shares</div>
                            </button>
                            <button class="action-card" onclick="showSection('savings')">
                                <div class="action-icon">🏦</div>
                                <div class="action-title">Savings Account</div>
                            </button>
                            <button class="action-card" onclick="showSection('loans')">
                                <div class="action-icon">📋</div>
                                <div class="action-title">Loan Services</div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Method Setup Modal -->
    <div id="paymentSetupModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Add Payment Method</h2>
                <span class="close" onclick="closePaymentSetupModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="payment-method-tabs">
                    <button class="method-tab active" onclick="switchMethodTab('ewallet')">📱 E-Wallet</button>
                    <button class="method-tab" onclick="switchMethodTab('bank')">🏦 Bank Account</button>
                </div>

                <!-- E-Wallet Form -->
                <form id="ewalletSetupForm" class="method-setup-form">
                    <div class="form-group">
                        <label>E-Wallet Provider *</label>
                        <select id="ewalletProvider" required>
                            <option value="">Select Provider</option>
                            <option value="GCash">GCash</option>
                            <option value="PayMaya">PayMaya / Maya</option>
                            <option value="GrabPay">GrabPay</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Registered Mobile Number *</label>
                        <input type="tel" id="ewalletMobile" placeholder="09XXXXXXXXX" maxlength="11" required>
                        <small>Must match your e-wallet registered number</small>
                    </div>

                    <div class="form-group">
                        <label>Account Name *</label>
                        <input type="text" id="ewalletName" required>
                        <small>Full name as registered in e-wallet</small>
                    </div>

                    <div class="form-group">
                        <label>Upload Screenshot of E-Wallet Profile *</label>
                        <input type="file" id="ewalletProof" accept="image/*" required>
                        <small>Show your name and mobile number (Max 5MB)</small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit for Verification</button>
                        <button type="button" class="btn btn-secondary" onclick="closePaymentSetupModal()">Cancel</button>
                    </div>
                </form>

                <!-- Bank Account Form -->
                <form id="bankSetupForm" class="method-setup-form" style="display: none;">
                    <div class="form-group">
                        <label>Bank Name *</label>
                        <select id="bankName" required>
                            <option value="">Select Bank</option>
                            <option value="BDO">BDO</option>
                            <option value="BPI">BPI</option>
                            <option value="Metrobank">Metrobank</option>
                            <option value="Unionbank">Unionbank</option>
                            <option value="Security Bank">Security Bank</option>
                            <option value="LandBank">LandBank</option>
                            <option value="PNB">PNB</option>
                            <option value="RCBC">RCBC</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Account Number *</label>
                        <input type="text" id="bankAccountNumber" required>
                    </div>

                    <div class="form-group">
                        <label>Account Name *</label>
                        <input type="text" id="bankAccountName" required>
                        <small>Must exactly match your bank account</small>
                    </div>

                    <div class="form-group">
                        <label>Upload Bank Statement or Passbook *</label>
                        <input type="file" id="bankProof" accept="image/*,.pdf" required>
                        <small>Show account name and number (Max 5MB)</small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit for Verification</button>
                        <button type="button" class="btn btn-secondary" onclick="closePaymentSetupModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Deposit Modal -->
    <div id="depositModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Deposit to Savings</h2>
                <span class="close" onclick="closeDepositModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="deposit-instructions">
                    <h4>📋 Deposit Instructions:</h4>
                    <ol>
                        <li>Send money to CLIMBS account using your verified payment method</li>
                        <li>Enter the transaction amount and reference number below</li>
                        <li>Upload proof of payment (screenshot)</li>
                        <li>Wait for admin verification (1-2 business days)</li>
                    </ol>
                </div>

                <div class="climbs-account-details">
                    <h4>💰 CLIMBS Account Details:</h4>
                    <div class="account-detail">
                        <strong>GCash:</strong> 0994-155-6747 (CLIMBS COOP)
                    </div>
                    <div class="account-detail">
                        <strong>BDO:</strong> XXXX-XXXX-XXXX (CLIMBS LIFE & GENERAL INSURANCE COOP)
                    </div>
                </div>

                <form id="depositForm">
                    <div class="form-group">
                        <label>Your Payment Method *</label>
                        <select id="depositPaymentMethod" required>
                            <option value="">Select your verified payment method</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Deposit Amount (₱) *</label>
                        <input type="number" id="depositAmount" min="100" step="50" required>
                        <small>Minimum: ₱100.00</small>
                    </div>

                    <div class="form-group">
                        <label>Transaction Reference Number *</label>
                        <input type="text" id="depositReference" placeholder="e.g., GCash Ref: 1234567890" required>
                    </div>

                    <div class="form-group">
                        <label>Upload Proof of Payment *</label>
                        <input type="file" id="depositProof" accept="image/*" required>
                        <small>Screenshot showing: Amount, Date, Reference Number (Max 5MB)</small>
                    </div>

                    <div class="verification-notice">
                        ⏳ <strong>Note:</strong> Your deposit will be credited after admin verification (1-2 business days)
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit Deposit Request</button>
                        <button type="button" class="btn btn-secondary" onclick="closeDepositModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Withdraw Modal -->
    <div id="withdrawModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Withdraw from Savings</h2>
                <span class="close" onclick="closeWithdrawModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="withdrawal-notice-important">
                    <h4>⚠️ Important Withdrawal Information:</h4>
                    <ul>
                        <li>Funds will be sent to your verified payment method</li>
                        <li>Processing time: 2-3 business days after approval</li>
                        <li>Minimum withdrawal: ₱100.00</li>
                        <li>Subject to admin approval</li>
                    </ul>
                </div>

                <form id="withdrawForm">
                    <div class="form-group">
                        <label>Available Balance</label>
                        <div class="balance-highlight" id="withdrawAvailableBalance">₱0.00</div>
                    </div>

                    <div class="form-group">
                        <label>Withdrawal Amount (₱) *</label>
                        <input type="number" id="withdrawAmount" min="100" step="50" required>
                    </div>

                    <div class="form-group">
                        <label>Withdraw To *</label>
                        <select id="withdrawPaymentMethod" required>
                            <option value="">Select destination account</option>
                        </select>
                    </div>

                    <div id="withdrawDestination" class="selected-method-display" style="display: none;">
                        <!-- Will show selected payment method details -->
                    </div>

                    <div class="form-group">
                        <label>Reason for Withdrawal *</label>
                        <textarea id="withdrawReason" rows="3" required placeholder="e.g., Medical expenses, Emergency, etc."></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit Withdrawal Request</button>
                        <button type="button" class="btn btn-secondary" onclick="closeWithdrawModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Share Modal -->
    <div id="addShareModal" class="modal">
        <div class="modal-content modal-small">
            <div class="modal-header">
                <h2>Add Share Capital</h2>
                <span class="close" onclick="closeAddShareModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="addShareForm">
                    <div class="form-group">
                        <label>Amount (₱)</label>
                        <input type="number" id="shareAmount" min="100" step="100" required>
                        <small>Minimum: ₱100.00 per share</small>
                    </div>
                    <div class="form-group">
                        <label>Payment Method</label>
                        <select id="sharePaymentMethod" required>
                            <option value="">Select Payment Method</option>
                            <option value="Cash">Cash</option>
                            <option value="Check">Check</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" onclick="closeAddShareModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Loan Application Modal -->
    <div id="loanApplicationModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Loan Application</h2>
                <span class="close" onclick="closeLoanApplicationModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="loanApplicationForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Loan Type</label>
                            <select id="loanType" required>
                                <option value="">Select Loan Type</option>
                                <option value="Regular Loan">Regular Loan</option>
                                <option value="Emergency Loan">Emergency Loan</option>
                                <option value="Education Loan">Education Loan</option>
                                <option value="Housing Loan">Housing Loan</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Loan Amount (₱)</label>
                            <input type="number" id="loanAmount" min="5000" step="1000" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Loan Term (months)</label>
                            <input type="number" id="loanTerm" min="6" max="60" required>
                        </div>
                        <div class="form-group">
                            <label>Purpose</label>
                            <input type="text" id="loanPurpose" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Additional Notes</label>
                        <textarea id="loanNotes" rows="3"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit Application</button>
                        <button type="button" class="btn btn-secondary" onclick="closeLoanApplicationModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/member-dashboard.js"></script>
</body>
</html>