<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Ordering - CLIMBS</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/employee-ordering.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="header-left">
                <h1>🍽️ CLIMBS Canteen</h1>
                <span class="employee-badge" id="employeeBadge"></span>
            </div>
            <div class="header-right">
                <div class="wallet-info">
                    <span class="wallet-label">💰 Wallet Balance:</span>
                    <span class="wallet-amount" id="walletBalance">₱0.00</span>
                    <button class="btn btn-topup" onclick="showTopUpModal()">+ Top Up</button>
                </div>
                <button class="btn btn-logout" onclick="logout()">Logout</button>
            </div>
        </header>

        <div class="dashboard-nav">
            <button class="nav-btn active" onclick="showSection('order')">🛒 Order Now</button>
            <button class="nav-btn" onclick="showSection('history')">📜 Order History</button>
            <button class="nav-btn" onclick="showSection('favorites')">⭐ Favorites</button>
            <button class="nav-btn" onclick="showSection('credit')">💳 My Credit</button>
        </div>

        <!-- Order Section -->
        <div id="orderSection" class="content-section">
            <div class="ordering-layout">
                <div class="menu-panel">
                    <h2>Menu</h2>
                    <div class="menu-filters">
                        <button class="filter-btn active" onclick="filterMenu('all')">All</button>
                        <button class="filter-btn" onclick="filterMenu('meals')">Meals</button>
                        <button class="filter-btn" onclick="filterMenu('drinks')">Drinks</button>
                        <button class="filter-btn" onclick="filterMenu('snacks')">Snacks</button>
                    </div>
                    <div class="menu-grid" id="menuGrid">
                        <!-- Menu items will load here -->
                    </div>
                </div>

                <div class="cart-panel">
                    <h2>My Order</h2>
                    <div class="cart-items" id="cartItems">
                        <p class="empty-cart">Cart is empty</p>
                    </div>
                    <div class="cart-summary">
                        <div class="summary-row">
                            <span>Subtotal:</span>
                            <span id="cartSubtotal">₱0.00</span>
                        </div>
                        <div class="summary-row total">
                            <span>Total:</span>
                            <span id="cartTotal">₱0.00</span>
                        </div>
                    </div>
                    <div class="payment-options">
                        <label>
                            <input type="radio" name="paymentMethod" value="wallet" checked> 
                            💰 Pay with Wallet
                        </label>
                        <label>
                            <input type="radio" name="paymentMethod" value="credit"> 
                            💳 Use Credit (Pay Later)
                        </label>
                    </div>
                    <button class="btn btn-order" onclick="placeOrder()">Place Order</button>
                    <button class="btn btn-clear" onclick="clearCart()">Clear Cart</button>
                </div>
            </div>
        </div>

        <!-- Order History Section -->
        <div id="historySection" class="content-section" style="display: none;">
            <div class="history-panel">
                <h2>Order History</h2>
                <div id="orderHistory">
                    <!-- Order history will load here -->
                </div>
            </div>
        </div>

        <!-- Favorites Section -->
        <div id="favoritesSection" class="content-section" style="display: none;">
            <div class="favorites-panel">
                <h2>My Favorite Orders</h2>
                <div id="favoritesList">
                    <!-- Favorites will load here -->
                </div>
            </div>
        </div>

        <!-- Credit Section -->
        <div id="creditSection" class="content-section" style="display: none;">
            <div class="credit-panel">
                <h2>My Credit Balance</h2>
                <div class="credit-summary">
                    <div class="credit-amount">
                        <span class="amount-label">Total Credit Used:</span>
                        <span class="amount-value" id="creditAmount">₱0.00</span>
                    </div>
                    <button class="btn btn-primary" onclick="showPayCreditModal()">Pay Credit</button>
                </div>
                <div id="creditHistory">
                    <!-- Credit history will load here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Top Up Modal -->
    <div id="topUpModal" class="modal">
        <div class="modal-content modal-small">
            <div class="modal-header">
                <h2>Top Up Wallet</h2>
                <span class="close" onclick="closeTopUpModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="topUpForm">
                    <div class="form-group">
                        <label>Amount to Add (₱)</label>
                        <input type="number" id="topUpAmount" min="50" step="50" required>
                    </div>
                    <div class="quick-amounts">
                        <button type="button" onclick="setTopUp(100)">₱100</button>
                        <button type="button" onclick="setTopUp(200)">₱200</button>
                        <button type="button" onclick="setTopUp(500)">₱500</button>
                        <button type="button" onclick="setTopUp(1000)">₱1000</button>
                    </div>
                    <button type="submit" class="btn btn-primary">Add to Wallet</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Order Success Modal -->
    <div id="orderSuccessModal" class="modal">
        <div class="modal-content modal-small">
            <div class="modal-header success-header">
                <h2>✓ Order Placed!</h2>
            </div>
            <div class="modal-body">
                <div id="orderSuccessMessage"></div>
                <button class="btn btn-primary" onclick="closeOrderSuccess()">OK</button>
            </div>
        </div>
    </div>

    <script src="/js/employee-ordering.js"></script>
</body>
</html>