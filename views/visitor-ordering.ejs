<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visitor Ordering - CLIMBS</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/visitor-ordering.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🍽️ CLIMBS Canteen - Walk-in Order</h1>
            <a href="/ordering-system" class="back-btn">← Back</a>
        </header>

        <div class="ordering-layout">
            <div class="menu-panel">
                <h2>Menu</h2>
                <div class="menu-filters">
                    <button class="filter-btn active" onclick="filterMenu('all')">All</button>
                    <button class="filter-btn" onclick="filterMenu('meals')">Meals</button>
                    <button class="filter-btn" onclick="filterMenu('drinks')">Drinks</button>
                    <button class="filter-btn" onclick="filterMenu('snacks')">Snacks</button>
                </div>
                <div class="menu-grid" id="menuGrid">
                    <!-- Menu items will load here -->
                </div>
            </div>

            <div class="cart-panel">
                <h2>Your Order</h2>
                
                <div class="payment-method-section">
                    <h3>Payment Method</h3>
                    <div class="payment-options">
                        <label class="payment-option">
                            <input type="radio" name="visitorPayment" value="cash" checked>
                            <span class="payment-label">💵 Cash</span>
                        </label>
                        <label class="payment-option">
                            <input type="radio" name="visitorPayment" value="ewallet">
                            <span class="payment-label">📱 E-Wallet (GCash/PayMaya)</span>
                        </label>
                    </div>
                </div>

                <div class="cart-items" id="cartItems">
                    <p class="empty-cart">Cart is empty</p>
                </div>

                <div class="cart-summary">
                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span id="cartSubtotal">₱0.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total:</span>
                        <span id="cartTotal">₱0.00</span>
                    </div>
                </div>

                <div class="payment-section">
                    <h3>Payment Details</h3>
                    
                    <!-- Cash Payment Section -->
                    <div id="cashPaymentDetails" class="payment-details">
                        <div class="form-group">
                            <label>Amount Paid (₱)</label>
                            <input type="number" id="amountPaid" min="0" step="0.01">
                        </div>
                        <div class="change-display">
                            <span>Change:</span>
                            <span id="changeAmount">₱0.00</span>
                        </div>
                    </div>
                    
                    <!-- E-Wallet Payment Section -->
                    <div id="ewalletPaymentDetails" class="payment-details" style="display: none;">
                        <div class="ewallet-info">
                            <p><strong>Scan QR Code or Send to:</strong></p>
                            <div class="qr-code">
                                <div class="qr-placeholder">
                                    📱<br>
                                    QR Code Here
                                </div>
                            </div>
                            <p class="ewallet-number"><strong>GCash/PayMaya:</strong> 0917-123-4567</p>
                            <p class="ewallet-name"><strong>Account Name:</strong> CLIMBS Canteen</p>
                            <div class="form-group">
                                <label>Reference Number</label>
                                <input type="text" id="ewalletReference" placeholder="Enter reference number">
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-order" onclick="placeOrder()">Place Order</button>
                <button class="btn btn-clear" onclick="clearCart()">Clear Cart</button>
            </div>
        </div>
    </div>

    <script src="/js/visitor-ordering.js"></script>
</body>
</html>