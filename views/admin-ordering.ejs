<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - CLIMBS Canteen</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin-ordering.css">
</head>
<body>
    <div class="container-fluid">
        <header>
            <div class="header-left">
                <h1>⚙️ Admin Dashboard</h1>
            </div>
            <div class="header-right">
                <span class="admin-badge">Administrator</span>
                <a href="/admin-profile" class="btn btn-profile">👤 Profile</a>
                <button class="btn btn-logout" onclick="logout()">Logout</button>
            </div>
        </header>
        <div class="dashboard-nav">
            <button class="nav-btn active" onclick="showSection('overview')">📊 Overview</button>
            <button class="nav-btn" onclick="showSection('menu')">🍽️ Menu Management</button>
            <button class="nav-btn" onclick="showSection('inventory')">📦 Inventory</button>
            <button class="nav-btn" onclick="showSection('orders')">📋 Orders</button>
            <button class="nav-btn" onclick="showSection('reports')">📈 Reports</button>
            <button class="nav-btn" onclick="showSection('credits')">💳 Employee Credits</button>
        </div>

        <!-- Overview Section -->
        <div id="overviewSection" class="content-section">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">💰</div>
                    <div class="stat-info">
                        <div class="stat-value" id="todaySales">₱0.00</div>
                        <div class="stat-label">Today's Sales</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🛒</div>
                    <div class="stat-info">
                        <div class="stat-value" id="todayOrders">0</div>
                        <div class="stat-label">Today's Orders</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📦</div>
                    <div class="stat-info">
                        <div class="stat-value" id="lowStock">0</div>
                        <div class="stat-label">Low Stock Items</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">💳</div>
                    <div class="stat-info">
                        <div class="stat-value" id="totalCredits">₱0.00</div>
                        <div class="stat-label">Total Credits</div>
                    </div>
                </div>
            </div>

            <div class="recent-activity">
                <h2>Recent Orders</h2>
                <div id="recentOrders">
                    <!-- Recent orders will load here -->
                </div>
            </div>
        </div>

        <!-- Menu Management Section -->
        <div id="menuSection" class="content-section" style="display: none;">
            <div class="section-header">
                <h2>Menu Management</h2>
                <button class="btn btn-primary" onclick="showAddMenuItem()">+ Add Menu Item</button>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="menuTableBody">
                    <!-- Menu items will load here -->
                </tbody>
            </table>
        </div>

        <!-- Inventory Section -->
        <div id="inventorySection" class="content-section" style="display: none;">
            <div class="section-header">
                <h2>Inventory Management</h2>
                <button class="btn btn-primary" onclick="showUpdateStockModal()">Update Stock</button>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Current Stock</th>
                        <th>Minimum Stock</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody">
                    <!-- Inventory items will load here -->
                </tbody>
            </table>
        </div>

        <!-- Orders Section -->
        <div id="ordersSection" class="content-section" style="display: none;">
            <div class="section-header">
                <h2>Order History</h2>
                <div class="filter-controls">
                    <select id="orderFilter" onchange="filterOrders()">
                        <option value="all">All Orders</option>
                        <option value="today">Today</option>
                        <option value="week">This Week</option>
                        <option value="month">This Month</option>
                    </select>
                </div>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total Amount</th>
                        <th>Payment Method</th>
                        <th>Date & Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="ordersTableBody">
                    <!-- Orders will load here -->
                </tbody>
            </table>
        </div>

        <!-- Reports Section -->
        <div id="reportsSection" class="content-section" style="display: none;">
            <div class="section-header">
                <h2>Sales Reports</h2>
            </div>

            <div class="report-tabs">
                <button class="report-tab active" onclick="showReport('daily')">Daily</button>
                <button class="report-tab" onclick="showReport('monthly')">Monthly</button>
                <button class="report-tab" onclick="showReport('yearly')">Yearly</button>
            </div>

            <!-- Daily Report -->
            <div id="dailyReport" class="report-panel">
                <h3>Daily Sales Report</h3>
                <div class="report-filters">
                    <input type="date" id="dailyDate">
                    <button class="btn btn-secondary" onclick="generateDailyReport()">Generate</button>
                </div>
                <div id="dailyReportContent">
                    <!-- Report content will load here -->
                </div>
            </div>

            <!-- Monthly Report -->
            <div id="monthlyReport" class="report-panel" style="display: none;">
                <h3>Monthly Sales Report</h3>
                <div class="report-filters">
                    <select id="monthlyMonth">
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                    <select id="monthlyYear">
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                    </select>
                    <button class="btn btn-secondary" onclick="generateMonthlyReport()">Generate</button>
                </div>
                <div id="monthlyReportContent">
                    <!-- Report content will load here -->
                </div>
            </div>

            <!-- Yearly Report -->
            <div id="yearlyReport" class="report-panel" style="display: none;">
                <h3>Yearly Sales Report</h3>
                <div class="report-filters">
                    <select id="yearlyYear">
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                    </select>
                    <button class="btn btn-secondary" onclick="generateYearlyReport()">Generate</button>
                </div>
                <div id="yearlyReportContent">
                    <!-- Report content will load here -->
                </div>
            </div>
        </div>

        <!-- Credits Section -->
        <div id="creditsSection" class="content-section" style="display: none;">
            <div class="section-header">
                <h2>Employee Credits</h2>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Credit Balance</th>
                        <th>Last Transaction</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="creditsTableBody">
                    <!-- Credits will load here -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add/Edit Menu Item Modal -->
    <div id="menuItemModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="menuModalTitle">Add Menu Item</h2>
                <span class="close" onclick="closeMenuItemModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="menuItemForm">
                    <input type="hidden" id="itemId">
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Item Name *</label>
                            <input type="text" id="itemName" required>
                        </div>
                        <div class="form-group">
                            <label>Emoji *</label>
                            <input type="text" id="itemEmoji" maxlength="2" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Category *</label>
                            <select id="itemCategory" required>
                                <option value="">Select Category</option>
                                <option value="meals">Meals</option>
                                <option value="drinks">Drinks</option>
                                <option value="snacks">Snacks</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Price (₱) *</label>
                            <input type="number" id="itemPrice" min="1" step="0.01" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Initial Stock *</label>
                            <input type="number" id="itemStock" min="0" required>
                        </div>
                        <div class="form-group">
                            <label>Minimum Stock *</label>
                            <input type="number" id="itemMinStock" min="0" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="itemAvailable" checked>
                            Available for ordering
                        </label>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Item</button>
                        <button type="button" class="btn btn-secondary" onclick="closeMenuItemModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Update Stock Modal -->
    <div id="updateStockModal" class="modal">
        <div class="modal-content modal-small">
            <div class="modal-header">
                <h2>Update Stock</h2>
                <span class="close" onclick="closeUpdateStockModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="updateStockForm">
                    <div class="form-group">
                        <label>Select Item</label>
                        <select id="stockItemSelect" required>
                            <option value="">Select an item</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Current Stock: <span id="currentStock">0</span></label>
                    </div>

                    <div class="form-group">
                        <label>Add Quantity</label>
                        <input type="number" id="addStock" min="1" required>
                    </div>

                    <button type="submit" class="btn btn-primary">Update Stock</button>
                </form>
            </div>
        </div>
    </div>

    <!-- View Order Details Modal -->
    <div id="orderDetailsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Order Details</h2>
                <span class="close" onclick="closeOrderDetailsModal()">&times;</span>
            </div>
            <div class="modal-body" id="orderDetailsContent">
                <!-- Order details will load here -->
            </div>
        </div>
    </div>

    <script src="/js/admin-ordering.js"></script>
</body>
</html>