<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visitor Ordering - CLIMBS</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/visitor-ordering.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🍽️ CLIMBS Canteen - Walk-in Order</h1>
            <a href="/ordering-system" class="back-btn">← Back</a>
        </header>

        <div class="ordering-layout">
            <div class="menu-panel">
                <h2>Menu</h2>
                <div class="menu-filters">
                    <button class="filter-btn active" onclick="filterMenu('all')">All</button>
                    <button class="filter-btn" onclick="filterMenu('meals')">Meals</button>
                    <button class="filter-btn" onclick="filterMenu('drinks')">Drinks</button>
                    <button class="filter-btn" onclick="filterMenu('snacks')">Snacks</button>
                </div>
                <div class="menu-grid" id="menuGrid">
                    <!-- Menu items will load here -->
                </div>
            </div>

            <div class="cart-panel">
                <h2>Your Order</h2>
                
                <div class="customer-info">
                    <input type="text" id="customerName" placeholder="Your Name (Optional)">
                </div>

                <div class="cart-items" id="cartItems">
                    <p class="empty-cart">Cart is empty</p>
                </div>

                <div class="cart-summary">
                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span id="cartSubtotal">₱0.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total:</span>
                        <span id="cartTotal">₱0.00</span>
                    </div>
                </div>

                <div class="payment-section">
                    <h3>Payment</h3>
                    <div class="form-group">
                        <label>Amount Paid (₱)</label>
                        <input type="number" id="amountPaid" min="0" step="0.01">
                    </div>
                    <div class="change-display">
                        <span>Change:</span>
                        <span id="changeAmount">₱0.00</span>
                    </div>
                </div>

                <button class="btn btn-order" onclick="placeOrder()">Place Order</button>
                <button class="btn btn-clear" onclick="clearCart()">Clear Cart</button>
            </div>
        </div>
    </div>

    <script src="/js/visitor-ordering.js"></script>
</body>
</html>