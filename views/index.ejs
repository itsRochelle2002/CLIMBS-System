<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CLIMBS System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>CESLA MULTI-PURPOSE COOPERATIVE</h1>
            <p>System Portal</p>
        </header>
        
        <div class="modules">
            <div class="module-card">
                <h2>Membership Portal</h2>
                <p>Savings, Share Capital, Loans — register or sign in</p>
                <a href="/membership" class="btn">Go to Membership</a>
                <small style="display:block; margin-top:8px; opacity:0.9;">Login → Member Dashboard (savings, share capital, loans)</small>
            </div>
            
            <div class="module-card">
                <h2>CANTEEN MANAGEMENT SYSTEM</h2>
                <p>Employee food ordering system</p>
                <a href="/ordering" class="btn">Go to Ordering</a>
            </div>
        </div>
    </div>
</body>
</html>